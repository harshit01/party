# ─────────────────────────────────────────────────────────────
# Unity — generated / machine-local. Patterns are unanchored so
# they work whether the Unity project sits at the repo root or
# in a subfolder.
# ─────────────────────────────────────────────────────────────
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset Store tools / plugin caches
[Aa]ssets/AssetStoreTools*
[Aa]ssets/Plugins/Editor/JetBrains*

# Never commit Steam's redistributable binaries or an appid file
steam_api*.dll
steam_api*.so
steam_api*.dylib
[Ss]team_appid.txt

# Visual Studio / Rider / VS Code generated project files
.vs/
.vscode/
.idea/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for ignored folders
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt
crashlytics-build.properties

# Builds / packages
*.apk
*.aab
*.unitypackage
*.app

# ─────────────────────────────────────────────────────────────
# Python (host service)
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ─────────────────────────────────────────────────────────────
# Secrets — the OpenAI key must never reach the repo
# ─────────────────────────────────────────────────────────────
.env
.env.*
*.key
secrets.json

# ─────────────────────────────────────────────────────────────
# macOS
# ─────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
