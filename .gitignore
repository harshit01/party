# ─────────────────────────────────────────────────────────────
# Unity — generated / machine-local. Patterns are unanchored so
# they work whether the Unity project sits at the repo root or
# in a subfolder.
# ─────────────────────────────────────────────────────────────
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset Store tools / plugin caches
[Aa]ssets/AssetStoreTools*
[Aa]ssets/Plugins/Editor/JetBrains*

# Steam redistributables: NOT ignored. Steamworks.NET needs them at runtime, and
# ignoring them would hand the Windows laptop a project that cannot initialise
# Steam. They come via the UPM package (so they live in the gitignored
# Library/PackageCache and are resolved per machine), but if the SDK is ever
# vendored into Assets/ these must be committed - .gitattributes sends the
# binaries to LFS. steam_appid.txt is likewise committed: both machines need the
# same appid (480 / Spacewar) for the P2P milestone.

# Visual Studio / Rider / VS Code generated project files
.vs/
.vscode/
.idea/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for ignored folders
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt
crashlytics-build.properties

# Builds / packages
*.apk
*.aab
*.unitypackage
*.app

# ─────────────────────────────────────────────────────────────
# Python (host service)
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ─────────────────────────────────────────────────────────────
# Secrets — the OpenAI key must never reach the repo
# ─────────────────────────────────────────────────────────────
.env
.env.*
*.key
secrets.json

# ─────────────────────────────────────────────────────────────
# macOS
# ─────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# Mono crash dumps from the intermittently-corrupt player builds (see HANDOFF KNOWN ISSUE)
mono_crash.*.json
